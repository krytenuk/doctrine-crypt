{
  "name": "krytenuk/doctrine-crypt",
  "description": "Automatic encryption and decryption of Doctrine ORM entity fields using attributes and CipherSweet",
  "require": {
    "php": "^8.2",
    "ext-sodium": "*",
    "doctrine/orm": "^2.20",
    "doctrine/event-manager": "^1.2 || ^2.0",
    "laminas/laminas-filter": "^2.40",
    "paragonie/ciphersweet": "^4.7",
    "psr/container": "^1.1 || ^2.0",
    "symfony/console": "^5.4 || ^6.0 || ^7.0 || ^8.0"
  },
  "authors": [
    {
      "name": "Garry Childs",
      "email": "info@freedomwebservices.net",
      "homepage": "https://www.freedomwebservices.net/laminas/fws-doctrine-crypt"
    }
  ],
  "keywords": [
    "mezzio",
    "laminas",
    "encryption",
    "decryption",
    "doctrine",
    "ORM",
    "ciphersweet",
    "freedom"
  ],
  "autoload": {
    "psr-4": {
      "FwsDoctrineCrypt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FwsDoctrineCrypt\\Test\\": "tests/"
    }
  },
  "license": "MIT",
  "type": "library",
  "homepage": "https://www.freedomwebservices.net/laminas/fws-doctrine-crypt",
  "extra": {
    "laminas": {
      "config-provider": "FwsDoctrineCrypt\\ConfigProvider"
    }
  },
  "funding": [
    {
      "type": "other",
      "url": "https://www.freedomwebservices.net/laminas/fws-doctrine-crypt#donate"
    }
  ],
  "require-dev": {
    "laminas/laminas-servicemanager": "^3.22",
    "phpunit/phpunit": "^11.5",
    "roave/psr-container-doctrine": "^4.2"
  }
}
